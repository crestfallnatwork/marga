# Ignore vim undo file
*.un~

# Compiled Object files
*.slo
*.lo
*.o

# Compiled Dynamic libraries
*.so
*.dylib

# Compiled Static libraries
*.lai
*.la
*.a

# Build directories
build*/
build_*/
*_build/
.cmake/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt
!cmake/*.cmake
!pictor_core/cmake/*.cmake
!pictor_core/test/*.cmake

# Test/benchmark results
*.csv
*.db
*.stats.csv
*.sysinfo.txt
results/

# Published benchmark data stays trackable despite the global *.csv ignore
!artifacts/csvs/**
!artifacts/csvs/*.csv

# Local tooling state
.opencode/
__pycache__/
*.pyc

# clangd cache
.cache
temp

# Local scratch space for scripts, logs, throwaway outputs
scratch/

# API keys
.env.local
